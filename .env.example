# Recipient address for lead/contact-form submissions.
LEAD_TO_EMAIL=

# Sender address used on outgoing lead notification emails.
LEAD_FROM_EMAIL=

# Resend API key, used to send transactional lead emails.
RESEND_API_KEY=

# SMTP fallback (nodemailer) — used if Resend is not configured.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
